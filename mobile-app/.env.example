# Copy to .env and fill in. EXPO_PUBLIC_* values are baked into the app when it is bundled,
# so rebuild the APK after changing them.

# FastAPI backend base URL (no trailing slash). A phone can't reach "localhost" on your computer:
#   - Android emulator:            http://10.0.2.2:8000
#   - Phone on the same Wi-Fi:     http://<your computer's LAN IP>:8000  (run uvicorn with --host 0.0.0.0)
#   - Deployed backend:            https://api.example.com
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# Number of OTP digits the backend expects
EXPO_PUBLIC_OTP_LENGTH=4

# Optional: shows a "Demo: use code ..." hint on the OTP step. Leave empty in production.
EXPO_PUBLIC_DEMO_OTP=
