# ---------- App ----------
# local | test | staging | production
ENVIRONMENT=local
APP_NAME=Task Mon API
DEBUG=false
# Set to false in production to hide /docs, /redoc and /openapi.json
DOCS_ENABLED=true

# ---------- Logging ----------
LOG_LEVEL=INFO
# true = one JSON object per line (for log shippers)
LOG_JSON=false

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=taskmon
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false
# Optional: a full SQLAlchemy URL overrides the DB_* values above
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/taskmon?charset=utf8mb4

# ---------- Auth ----------
# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-32-plus-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------- OTP ----------
# Hardcoded until an SMS provider is integrated
STATIC_OTP=1234
# Prefix applied to bare 10-digit numbers
DEFAULT_COUNTRY_CODE=91

# ---------- Groq LLM ----------
# Server-side only. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Seconds per Groq request, and automatic retries on timeouts / rate limits / 5xx
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_RETRIES=2
# low | medium | high for openai/gpt-oss-* models; leave empty for other models
GROQ_REASONING_EFFORT=low

# ---------- Chat engine ----------
# true = log every chat step at INFO and return the steps to the frontend (debug panel)
CHAT_DEBUG=true
# Minutes a question (missing info, pick one, confirm) stays open
PENDING_ACTION_MINUTES=15

# ---------- Push notifications (reminder worker) ----------
# Path to the Firebase Admin SDK service-account JSON (Firebase console → Project settings →
# Service accounts → Generate new private key). A secret: keep it out of git and the image.
# In Docker, mount it read-only and point here, e.g. /run/secrets/firebase-key.json
FIREBASE_CREDENTIALS_FILE=
# Seconds between checks for due reminders
WORKER_INTERVAL_SECONDS=30

# ---------- CORS ----------
# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
